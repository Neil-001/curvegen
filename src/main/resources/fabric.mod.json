{
  "schemaVersion": 1,
  "id": "curvegen",
  "version": "${version}",
  "name": "Curve Generator",
  "description": "Turn ellipses, equations and Bézier curves into full blocks, slabs, stairs, trapdoors, fences, glass panes and walls, then place them with a hologram or export them to Litematica.",
  "authors": ["Neil C."],
  "contact": {
    "homepage": "https://modrinth.com/mod/curvegen",
    "sources": "https://github.com/Neil-001/curvegen",
    "issues": "https://github.com/Neil-001/curvegen/issues"
  },
  "license": "MIT",
  "icon": "assets/curvegen/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.curvegen.fabric.CurveGenFabric"],
    "client": ["dev.curvegen.client.fabric.CurveGenFabricClient"]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": ">=26.1 <=26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
