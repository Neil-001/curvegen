{
  "schemaVersion": 1,
  "id": "curvegen",
  "version": "${version}",
  "name": "Curve Generator",
  "description": "Turn ellipses, equations, Bézier curves and 3D shapes into full blocks, slabs, stairs, trapdoors, fences, glass panes and walls. Edit them as a hologram in the world, then place them or export them to Litematica.",
  "authors": ["Neil C."],
  "contact": {
    "homepage": "https://modrinth.com/mod/curvegen",
    "sources": "https://github.com/Neil-001/curvegen",
    "issues": "https://github.com/Neil-001/curvegen/issues"
  },
  "license": "MIT",
  "icon": "assets/curvegen/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.curvegen.fabric.CurveGenFabric"],
    "client": ["dev.curvegen.client.fabric.CurveGenFabricClient"],
    "modmenu": ["dev.curvegen.client.fabric.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "curvegen.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": ">=0.160.6"
  }
}
